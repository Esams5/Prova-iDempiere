Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Prova iDempiere - Solicitacao de Compra
Bundle-SymbolicName: br.com.prova.idempiere;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Vendor: Prova iDempiere
Bundle-RequiredExecutionEnvironment: JavaSE-17
Automatic-Module-Name: br.com.prova.idempiere
Require-Bundle: org.adempiere.base;bundle-version="[12.0.0,15.0.0)",
 org.adempiere.plugin.utils;bundle-version="[12.0.0,15.0.0)"
Import-Package: org.osgi.service.component.annotations;version="[1.4.0,2.0.0)",
 org.osgi.service.event;version="[1.4.0,2.0.0)"
Service-Component: OSGI-INF/callout-factory.xml,
 OSGI-INF/process-factory.xml,
 OSGI-INF/model-validator-factory.xml,
 OSGI-INF/event-manager.xml
Bundle-ActivationPolicy: lazy

